# =================================================================
# Kisan Pehele — Environment Configuration Template
# Tagline: "Pehle pata, phir mandi."
# =================================================================

# Server Configuration
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL="file:./dev.db"
# For PostgreSQL production:
# DATABASE_URL="postgresql://kisan_user:kisan_secure_pass@localhost:5432/kisan_pehele_db?schema=public"

# Redis Cache & BullMQ Queue (Optional in dev, falls back to in-memory)
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="kisan_pehele_jwt_super_secret_key_sih26032_2026"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="kisan_pehele_refresh_token_key_sih26032_2026"

# Telecom & Multi-Channel Providers (Adapter Pattern)
SMS_PROVIDER="mock" # "mock" | "twilio" | "msg91" | "fast2sms"
SMS_API_KEY="mock_sms_api_key"
IVR_PROVIDER="mock" # "mock" | "exotel" | "twilio"
IVR_WEBHOOK_SECRET="mock_ivr_secret"
VOICE_SYNTHESIS_ENGINE="webspeech" # "webspeech" | "bhashini" | "elevenlabs"

# Government & Payment Integration Adapters
GOVERNMENT_PROCUREMENT_API="mock" # "mock" | "enam" | "fci_eprocure"
PAYMENT_GATEWAY_PROVIDER="mock" # "mock" | "dbt_pfms" | "razorpay"

# AI Intelligence Services
AI_MODEL_VERSION="v1.4-hybrid-rule"
WAIT_PREDICTION_CONFIDENCE_THRESHOLD=0.75
DEMAND_FORECAST_WINDOW_DAYS=14
